# ===================================
# AI 服务 API 密钥
# ===================================

# Google Gemini API 密钥 (必需)
# 获取地址: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Deepgram API 密钥 (必需 - 用于语音识别)
# 获取地址: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ElevenLabs API 密钥 (必需 - 用于语音合成)
# 获取地址: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ===================================
# Twilio 配置 (用于 SIP 电话)
# ===================================

# Twilio Account SID (必需)
# 获取地址: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here

# Twilio Auth Token (必需)
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Twilio 电话号码 (必需 - 格式: +1234567890)
TWILIO_PHONE_NUMBER=+1234567890

# ===================================
# 服务器配置
# ===================================

# 服务器主机地址
HOST=0.0.0.0

# 服务器端口
PORT=7860

# 公网 URL (必需 - 用于 Twilio webhook)
# 例如: https://your-domain.com 或 https://xxx.ngrok.io
PUBLIC_URL=https://your-public-url-here

# ===================================
# ElevenLabs 语音配置
# ===================================

# ElevenLabs Voice ID (可选 - 默认使用印度口音)
# 获取语音列表: https://elevenlabs.io/app/voice-library
# 印度口音推荐:
# - pNInz6obpgDQGcFmaJgB (Adam)
# - 21m00Tcm4TlvDq8ikWAM (Rachel)
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# ===================================
# 日志配置
# ===================================

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
